# Haveri API (subdomain)
api.haveri.tech {
    reverse_proxy haveri-backend:8000
}

# Haveri Main Domain
haveri.tech {
    route /api/* {
        reverse_proxy haveri-backend:8000
    }
    handle {
        root * /app/dist
        file_server
        try_files {path} /index.html
    }
}

# Juristi API (subdomain)
api.juristi.tech {
    reverse_proxy juristi-backend:8000
}

# Juristi Main Domain
juristi.tech {
    route /api/* {
        reverse_proxy juristi-backend:8000
    }
    handle {
        root * /app/dist
        file_server
        try_files {path} /index.html
    }
}