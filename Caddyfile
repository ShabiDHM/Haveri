# Haveri API (Dedicated Subdomain)
api.haveri.tech {
    reverse_proxy haveri-backend:8000
}

# Haveri Main Domain
haveri.tech {
    # Forward all API traffic specifically to the backend container
    # handle_path strips /api from the incoming request if needed, 
    # but here we keep /api/v1 to match FastAPI expectations.
    handle_path /api/* {
        reverse_proxy haveri-backend:8000
    }

    # Serve the frontend
    handle {
        root * /app/dist
        try_files {path} {path}/ /index.html
        file_server
    }
}

# Juristi API (Dedicated Subdomain)
api.juristi.tech {
    reverse_proxy juristi-backend:8000
}

# Juristi Main Domain
juristi.tech {
    handle_path /api/* {
        reverse_proxy juristi-backend:8000
    }
    handle {
        root * /app/dist
        try_files {path} {path}/ /index.html
        file_server
    }
}